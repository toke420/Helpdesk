# Copy to .env and fill in.

# Public URL of the help desk (where agents sign in and widget.js is served).
HELPDESK_BASE_URL=https://help.example.com

# Sites allowed to embed the chat widget, comma-separated, no trailing slash.
HELPDESK_ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Set to true when running behind a reverse proxy (needed for per-IP rate limits).
HELPDESK_TRUST_PROXY=true

# First admin — only used when the database has no agents yet.
# Default sign-in: admin@example.com / ChangeMe-123
# Change these BEFORE the first start, or sign in and change them straight away
# (Settings → Team). Leave the password empty to have a random one generated
# and printed in the logs instead.
HELPDESK_ADMIN_EMAIL=admin@example.com
HELPDESK_ADMIN_PASSWORD=ChangeMe-123

# Optional: AI (Copilot for agents + an AI agent for customers).
# Turn the customer-facing AI agent on in Settings → AI once this is set.
#
# Claude (default): get a key at https://platform.claude.com
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
#
# Or any OpenAI-compatible API — e.g. a local Ollama on the same Docker host,
# so conversations never leave your server (no key needed):
# AI_PROVIDER=openai
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=llama3.2:3b
# AI_API_KEY=

# Optional: email replies to customers who've left the site.
# Port 587 uses STARTTLS, 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Support <support@example.com>

# When everyone is Away or signed out of the inbox, new chat messages are sent
# with ntfy (https://ntfy.sh). Use a long, hard-to-guess topic: anyone who knows
# a public ntfy.sh topic name can read it. NTFY_TOKEN is only for protected topics.
NTFY_URL=
NTFY_TOKEN=
# If ntfy isn't set up or fails, they're emailed here instead (needs SMTP above).
NOTIFY_EMAIL=
